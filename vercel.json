<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visualisasi 3D Jembatan UGM</title>
  <style>
    body { 
      margin: 0; 
      overflow: hidden; 
      background-color: #87CEEB; /* Warna langit biru cerah */
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    }
    canvas { display: block; }
    #overlay {
      position: absolute;
      top: 20px;
      left: 20px;
      color: #1a202c;
      pointer-events: none;
      background: rgba(255,255,255,0.7);
      padding: 10px 20px;
      border-radius: 8px;
    }
    h1 { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: 0.05em; }
    p { margin: 5px 0 0 0; font-size: 12px; font-weight: 600; }
  </style>
</head>
<body>
  <div id="overlay">
    <h1>VISUALISASI JEMBATAN</h1>
    <p>Tahan klik kiri untuk memutar · Scroll untuk zoom</p>
  </div>

  <script async src="https://unpkg.com/es-module-shims@1.6.3/dist/es-module-shims.js"></script>
  
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.154.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.154.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    // 1. Setup Scene, Camera, & Renderer
    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog('#87CEEB', 50, 250);

    const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(60, 40, 80);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.maxPolarAngle = Math.PI / 2 - 0.02; 

    // 2. Pencahayaan
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight.position.set(50, 80, 50);
    dirLight.castShadow = true;
    dirLight.shadow.camera.left = -100;
    dirLight.shadow.camera.right = 100;
    dirLight.shadow.camera.top = 100;
    dirLight.shadow.camera.bottom = -100;
    scene.add(dirLight);

    // 3. Material (Disamakan dengan referensi PDF)
    const redArchMat = new THREE.MeshStandardMaterial({ color: 0xff1111, roughness: 0.4 }); // Merah terang
    const asphaltMat = new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.9 });
    const lineYellowMat = new THREE.MeshBasicMaterial({ color: 0xffcc00 });
    const lineWhiteMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
    const sidewalkMat = new THREE.MeshStandardMaterial({ color: 0xcccccc });
    const cableMat = new THREE.MeshStandardMaterial({ color: 0x999999, metalness: 0.6 });
    const riverMat = new THREE.MeshStandardMaterial({ color: 0x00ccff, flatShading: true, roughness: 0.1 }); // Biru cyan
    const landMat = new THREE.MeshStandardMaterial({ color: 0x7cb342, flatShading: true }); // Hijau topografi
    const dirtMat = new THREE.MeshStandardMaterial({ color: 0x8b5a2b }); // Cokelat tepi tanah
    const lampMat = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, metalness: 0.8 });

    const bridgeGroup = new THREE.Group();

    // 4. Membangun Struktur Jembatan
    const deckLength = 160;
    
    // Dek Utama (Aspal)
    const deckGeo = new THREE.BoxGeometry(deckLength, 1, 14);
    const deck = new THREE.Mesh(deckGeo, asphaltMat);
    deck.receiveShadow = true;
    bridgeGroup.add(deck);

    // Garis Kuning Ganda (Tengah)
    const yLineGeo = new THREE.PlaneGeometry(deckLength, 0.25);
    const yLine1 = new THREE.Mesh(yLineGeo, lineYellowMat);
    yLine1.rotation.x = -Math.PI / 2;
    yLine1.position.set(0, 0.51, 0.3);
    bridgeGroup.add(yLine1);
    
    const yLine2 = new THREE.Mesh(yLineGeo, lineYellowMat);
    yLine2.rotation.x = -Math.PI / 2;
    yLine2.position.set(0, 0.51, -0.3);
    bridgeGroup.add(yLine2);

    // Garis Putih (Tepi)
    const wLineGeo = new THREE.PlaneGeometry(deckLength, 0.2);
    const wLine1 = new THREE.Mesh(wLineGeo, lineWhiteMat);
    wLine1.rotation.x = -Math.PI / 2;
    wLine1.position.set(0, 0.51, 5.5);
    bridgeGroup.add(wLine1);
    
    const wLine2 = new THREE.Mesh(wLineGeo, lineWhiteMat);
    wLine2.rotation.x = -Math.PI / 2;
    wLine2.position.set(0, 0.51, -5.5);
    bridgeGroup.add(wLine2);

    // Trotoar/Tepian Jalan Putih
    const sidewalkGeo = new THREE.BoxGeometry(deckLength, 1.4, 2.5);
    const sw1 = new THREE.Mesh(sidewalkGeo, sidewalkMat);
    sw1.position.set(0, 0.2, 7.25);
    sw1.receiveShadow = true;
    bridgeGroup.add(sw1);
    
    const sw2 = new THREE.Mesh(sidewalkGeo, sidewalkMat);
    sw2.position.set(0, 0.2, -7.25);
    sw2.receiveShadow = true;
    bridgeGroup.add(sw2);

    // Tiang Lampu Jalan
    for (let x = -60; x <= 60; x += 30) {
        // Kiri
        const poleL = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.2, 7), lampMat);
        poleL.position.set(x, 3.5, 7.8);
        poleL.castShadow = true;
        bridgeGroup.add(poleL);
        const headL = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.2, 0.5), lampMat);
        headL.position.set(x, 7, 7.3);
        bridgeGroup.add(headL);

        // Kanan
        const poleR = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.2, 7), lampMat);
        poleR.position.set(x, 3.5, -7.8);
        poleR.castShadow = true;
        bridgeGroup.add(poleR);
        const headR = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.2, 0.5), lampMat);
        headR.position.set(x, 7, -7.3);
        bridgeGroup.add(headR);
    }

    // Pelengkung Merah (Arch)
    const archRadius = 50;
    const archGeo = new THREE.TorusGeometry(archRadius, 1.5, 8, 64, Math.PI);
    const archZOffset = 8;
    
    const arch1 = new THREE.Mesh(archGeo, redArchMat);
    arch1.position.set(0, 0, archZOffset);
    arch1.castShadow = true;
    bridgeGroup.add(arch1);

    const arch2 = new THREE.Mesh(archGeo, redArchMat);
    arch2.position.set(0, 0, -archZOffset);
    arch2.castShadow = true;
    bridgeGroup.add(arch2);

    // Hangers (Kabel) & Cross Bracing (Balok Melintang Merah)
    for (let x = -40; x <= 40; x += 10) {
      const height = Math.sqrt(archRadius * archRadius - x * x);
      const cableGeo = new THREE.CylinderGeometry(0.1, 0.1, height);
      
      const c1 = new THREE.Mesh(cableGeo, cableMat);
      c1.position.set(x, height / 2, archZOffset);
      c1.castShadow = true;
      bridgeGroup.add(c1);

      const c2 = new THREE.Mesh(cableGeo, cableMat);
      c2.position.set(x, height / 2, -archZOffset);
      c2.castShadow = true;
      bridgeGroup.add(c2);
    }

    // Balok melintang merah penghubung pelengkung
    for (let a = 45; a < 140; a += 15) {
      const rad = a * Math.PI / 180;
      const hx = Math.cos(rad) * archRadius;
      const hy = Math.sin(rad) * archRadius;
      if (hy > 15) {
         const strut = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.2, archZOffset * 2), redArchMat);
         strut.position.set(hx, hy, 0);
         strut.castShadow = true;
         bridgeGroup.add(strut);
      }
    }

    bridgeGroup.position.y = 8;
    scene.add(bridgeGroup);

    // 5. Permukaan Sungai Cyan & Daratan Kontur Terluar
    const river = new THREE.Mesh(new THREE.PlaneGeometry(500, 200), riverMat);
    river.rotation.x = -Math.PI / 2;
    river.position.y = 0;
    river.receiveShadow = true;
    scene.add(river);

    // Fungsi membuat daratan berundak (Topografi)
    function createTerrace(xOffset, isLeft) {
      const group = new THREE.Group();
      for(let i=0; i<5; i++) {
        const width = 80 + i * 15;
        const height = 2;
        const depth = 200;
        
        // Hijau atas
        const grass = new THREE.Mesh(new THREE.BoxGeometry(width, height, depth), landMat);
        const posX = isLeft ? (-xOffset - i*7) : (xOffset + i*7);
        grass.position.set(posX, i*2 + 1, 0);
        grass.receiveShadow = true;
        group.add(grass);
        
        // Cokelat bawah (tanah)
        const dirt = new THREE.Mesh(new THREE.BoxGeometry(width+0.2, height-0.2, depth+0.2), dirtMat);
        const dirtX = isLeft ? posX + 0.1 : posX - 0.1;
        dirt.position.set(dirtX, i*2 + 0.9, 0);
        group.add(dirt);
      }
      return group;
    }

    scene.add(createTerrace(80, true));  // Bank Kiri
    scene.add(createTerrace(80, false)); // Bank Kanan

    // 6. Render Loop
    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    // 7. Auto-Resize Canvas
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>